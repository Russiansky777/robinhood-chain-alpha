# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is git-ignored — see .gitignore.
#
# Dune Analytics API key (free tier: 2500 credits/month as of writing).
# Get one at https://dune.com/settings/api
DUNE_API_KEY=

# Alchemy API key — fallback data source if Dune credits/coverage run out.
# Get one at https://dashboard.alchemy.com/
# Robinhood Chain (chain id 4663) must be enabled on your Alchemy app.
ALCHEMY_API_KEY=
ALCHEMY_ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Blockscout PRO API key -- фолбэк, если ALCHEMY_API_KEY не задан (см.
# analysis/p3_dislocation_guard.py, Sprint P3-гард, docs/P3_GUARD.md).
# Robinhood Chain обслуживается через api.blockscout.com, требующий
# Bearer-токен даже для бесплатного тира (dev.blockscout.com) --
# анонимный eth-rpc для ЭТОГО чейна возвращает 403.
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_RPC_URL=https://api.blockscout.com/4663/json-rpc

# Optional: override default query params without editing config.py
COHORT_SIZE=200
MIN_TRADES=10
MIN_UNIQUE_TOKENS=5
SNIPER_TIME_WINDOW_MINUTES=5

# Смоук-тест перед масштабированием (см. docs/DATA_ACCESS.md)
SMOKE_DATE=2026-07-15
SMOKE_CREDIT_BUDGET=120

# Sprint 1.5 (см. docs/README.md, "Sprint 1.5")
COPYABILITY_MAX_TRADES=1500
COPYABILITY_MAX_TRADES_SENSITIVITY=3000
SNIPER_TIME_WINDOW_MINUTES_SENSITIVITY=1
PART1_ALPHA=0.01
PART1_MIN_LIFT=2.0
PART2_ALPHA=0.05
SPRINT15_CREDIT_BUDGET=250

# DBot REST (0 кредитов) -- используется analysis/solana_ledger_run.py
# (учёт follow_trades) и analysis/dbot_sold_position_guard.py (сторож
# проваленных продаж). До этой правки использовался везде, но не был
# документирован здесь.
DBOT_API_KEY=

# Helius Solana RPC -- используется теми же скриптами, что DBOT_API_KEY
# выше (getTransaction/getTokenAccountsByOwner и т.п.).
HELIUS_API=

# analysis/dbot_sold_position_guard.py -- сторож проваленных продаж
# (постоянная служба на NL-хосте, см. docs/DBOT_SOLD_POSITION_GUARD.md).
# GUARD_LIVE_SELL=1 включает реальную отправку продажи (по умолчанию
# "0" -- dry-run, тот же принцип, что --confirm-mainnet у sc1_launcher.py).
GUARD_LIVE_SELL=0
GUARD_INTERVAL_S=45
GUARD_STUCK_THRESHOLD=10
GUARD_API_DOWN_ALERT_S=600
# Опционально -- без них служба просто пишет алерты только в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
